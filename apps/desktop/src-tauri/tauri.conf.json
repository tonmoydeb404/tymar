{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tymar",
  "version": "0.2.0",
  "identifier": "com.tonmoydeb.tymar",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tymar",
        "hiddenTitle": true,
        "width": 420,
        "height": 720,
        "minWidth": 420,
        "minHeight": 720,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "tymar"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/tonmoydeb404/tymar/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4RjA5MDkzMDZGNzIzNDIKUldSQ0kvY0drNUR3bU4wa3JJQW50d1ZzdHdRL3RiRG1FQ28vY2VhM3JKRUxKczhNZ1lGQThwanQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "desktopTemplate": "linux-main.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux-main.desktop"
      }
    },
    "publisher": "Tonmoy Deb",
    "category": "public.app-category.developer-tools",
    "shortDescription": "Effortless time tracking for focused work.",
    "longDescription": "Tymar is a minimal, powerful time tracking app for macOS, Windows, and Linux. Focus on your work while Tymar handles the rest.",
    "copyright": "Copyright (c) 2026 Tonmoy Deb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
